{
	"name": "aibreze",
	"version": "0.1.0",
	"private": false,
	"type": "module",
	"description": "AI Febreze: markdown rules that spray performative / faux-profound register off prose. Core bans, smell audit, claims review, and genre overlays.",
	"license": "MIT",
	"author": "Catalyst Forge LLC",
	"keywords": [
		"ai",
		"writing",
		"style-guide",
		"prose",
		"llm",
		"prompts",
		"copyediting",
		"voice"
	],
	"homepage": "https://www.npmjs.com/package/aibreze",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./rules/*": "./rules/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts",
		"rules",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"test": "tsc && node --test dist/index.test.js",
		"prepare": "tsc",
		"prepublishOnly": "pnpm test"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.30.1",
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2"
	}
}
